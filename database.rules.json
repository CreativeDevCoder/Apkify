{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "apps": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "userBuilds": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".indexOn": [
          "createdAt",
          "appId"
        ]
      }
    },
    "builds": {
      ".indexOn": [
        "createdAt",
        "status"
      ],
      "$buildId": {
        ".read": "auth != null && (data.child('uid').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "stats": {
      "public": {
        ".read": true
      }
    },
    "config": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "providerUsage": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "posts": {
      ".indexOn": [
        "status"
      ]
    },
    "market": {
      ".indexOn": [
        "status"
      ]
    },
    "messages": {
      ".indexOn": [
        "createdAt"
      ]
    }
  }
}
