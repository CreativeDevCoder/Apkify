# Firebase Web Config (Project settings > General > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# URL Worker API. Kosongkan bila Worker dipasang di route yang sama: https://domainanda.com/api/*
VITE_API_BASE=
VITE_APP_NAME=Apkify

# Aplikasi Android pendamping (halaman /get-app). Build situs ini sendiri dengan Apkify, lalu isi salah satu:
VITE_COMPANION_APK_URL=
VITE_COMPANION_PLAY_URL=

# Email kontak di halaman Privasi/Ketentuan & link donasi (Saweria/Trakteer/dll.) di halaman Harga
VITE_CONTACT_EMAIL=
VITE_DONATE_URL=
